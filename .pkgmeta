package-as: ArbiterSoftReserve

# On CurseForge this addon needs Arbiter Loot Council (the project's slug), so the app installs it too.
required-dependencies:
  - arbiter-loot-council

ignore:
  - .luacheckrc
  - .gitattributes
  - .github
  - docs
  - Tests
  - Tools

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
